# Production env vars — read by Vite at build time only.
#
# VITE_* vars are baked into the client bundle and visible to anyone who
# views the page source. Do not put secrets here. The Turnstile site key
# is intentionally public; the matching secret is in Pages secrets.

VITE_TURNSTILE_SITE_KEY=0x4AAAAAADHL4ut81QmDeQJT
